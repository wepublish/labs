# Hermes internal profile — secrets. Copy to ~/.hermes/profiles/internal/.env on hermes01.
OPENROUTER_API_KEY=

# Slack (Socket Mode app for the internal workspace)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_ALLOWED_CHANNELS=   # comma-separated internal channel IDs

# RAGFlow (tenant-wide key — internal profile only; never reuse for support profiles)
RAGFLOW_BASE_URL=                 # http://onyx01.wepublish.cloud:<port>
RAGFLOW_API_KEY=
RAGFLOW_ALLOWED_DATASET_IDS=      # kb-ingest WRITE allowlist: all dataset IDs, comma-separated

# Phase-1 tracker
GITHUB_ISSUES_REPO=               # org/repo where support/engineering issues are filed

# CMS MCP (internal-only HTTP deployment)
CMS_MCP_URL=
CMS_MCP_AUTH_TOKEN=
