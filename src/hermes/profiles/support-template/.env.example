# Hermes support profile — secrets. One profile per newsroom.
OPENROUTER_API_KEY=

# Slack: this newsroom's dedicated channel ONLY
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_ALLOWED_CHANNELS=           # exactly one channel ID

# Scoped retrieval + ingest (consumed by skills, NOT MCP entries)
RAGFLOW_BASE_URL=                 # http://onyx01.wepublish.cloud:<port>
RAGFLOW_API_KEY=
RAGFLOW_DATASET_IDS=              # READ scope: public dataset ID + this newsroom's, comma-separated
RAGFLOW_ALLOWED_DATASET_IDS=      # WRITE scope: this newsroom's dataset ID ONLY
RAGFLOW_FORCE_SOURCE=newsroom-asserted
RAGFLOW_FORCE_CONFIDENCE=unverified

# Support→engineering routing (phase 1 tracker)
GITHUB_ISSUES_REPO=               # org/repo where support issues are filed

# CMS MCP pinned to this newsroom's deployment
CMS_MCP_URL=
CMS_MCP_AUTH_TOKEN=
