# We.Publish CMS MCP — environment contract (copy to .env; never commit real values)

# --- single-newsroom mode (one deployment per newsroom — recommended) ---
# Admin GraphQL endpoint. NOTE: the path is /v1 (one endpoint, public+admin).
WEPUBLISH_API_URL=https://api.example-newsroom.ch/v1
# Long-lived service token (sent as Bearer + User-Agent "We.Publish/1.0 Peering").
# Must be minted with a role carrying CanGetPaymentMethods/CanGetSubscriptions/CanGetSettings.
WEPUBLISH_API_TOKEN=replace-me
# Optional newsroom slug label (defaults to "default").
WEPUBLISH_TENANT=example

# --- fleet mode (one process serving several newsrooms) — overrides the above ---
# Concentrates several admin-read tokens in one process; prefer single mode.
# WEPUBLISH_UPSTREAMS={"tsri":{"apiUrl":"https://api.tsri.ch/v1","token":"..."},"hauptstadt":{"apiUrl":"https://api.hauptstadt.be/v1","token":"..."}}

# Environment label in the envelope + audit log. Optional.
WEPUBLISH_ENV=staging
# Request timeout ms. Optional (default 15000).
WEPUBLISH_TIMEOUT_MS=15000
# Audit principal (calling actor). Optional (default "hermes").
WEPUBLISH_PRINCIPAL=hermes

# --- HTTP transport only (U3) ---
# MANDATORY in HTTP mode (server refuses to boot without it). Bearer for the /mcp endpoint.
MCP_AUTH_TOKEN=
# HOST=0.0.0.0
# PORT=3000
# Comma-separated allowed Host headers (DNS-rebind protection).
# MCP_ALLOWED_HOSTS=localhost,cms-mcp.internal
